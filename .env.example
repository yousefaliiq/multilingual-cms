# PostgreSQL connection string. A Supabase PostgreSQL connection works here.
DATABASE_URL=

# Long random value used to sign administrator sessions.
SESSION_SECRET=

# Initial administrator. Used only if the users table is empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Supabase Storage configuration for cover-image uploads.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media

# Optional search-engine notification key.
INDEXNOW_KEY=
