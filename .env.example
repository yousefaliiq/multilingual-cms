# PostgreSQL connection string.
DATABASE_URL=

# Long random value used to sign administrator sessions.
SESSION_SECRET=

# Initial administrator. Used only if the users table is empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Protected Supabase Edge Function used for image uploads.
SUPABASE_UPLOAD_FUNCTION_URL=
SUPABASE_UPLOAD_TOKEN=

# Optional search-engine notification key.
INDEXNOW_KEY=
